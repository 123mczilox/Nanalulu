DJANGO_SECRET_KEY=replace-this-with-a-generated-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Contact form email. DEBUG=True uses the console backend unless EMAIL_BACKEND
# is explicitly set to Django's SMTP backend.
CONTACT_EMAIL_TO=contact@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
# Uncomment to deliver messages over SMTP while DEBUG=True.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# M-Pesa is optional for local development. Configure these to test payments.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
